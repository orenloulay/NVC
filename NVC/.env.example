# Copy this file to .env.local (for local dev) and set the same variables in
# your Vercel project's Environment Variables (for production).

# --- Database (required) ---------------------------------------------------
# Hosted libSQL / Turso database. Create one at https://turso.tech
#   turso db create nvc
#   turso db show nvc --url          -> TURSO_DATABASE_URL
#   turso db tokens create nvc       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Email delivery (required in production for login/signup codes) --------
# Without this, verification and 2FA codes are recorded but never delivered,
# so no one can sign in on the deployed site. Sign up at https://resend.com,
# create an API key, and (for real recipients) verify a sending domain.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's shared sandbox, which can only deliver
# to your own Resend account email. Use your own verified domain for real use.
RESEND_FROM=NVC <onboarding@resend.dev>

# --- NVC translation (optional) --------------------------------------------
# Enables real Claude translation; without it a clearly-labeled fallback runs.
ANTHROPIC_API_KEY=
# Optional Claude model id. Defaults to claude-opus-5.
NVC_MODEL=

# --- App (optional) --------------------------------------------------------
# Base URL used in invitation emails. On Vercel, set to your deployment URL.
APP_URL=http://localhost:3000
# Optional stable session-signing secret. If unset, one is generated and
# stored in the database. Set a long random value to keep sessions valid
# across database resets. Generate with: openssl rand -hex 48
SESSION_SECRET=
